# همه تنظیمات اختیاری هستند / All optional
SC_PORT=8000
SC_ADMIN_USERNAME=admin
SC_ADMIN_PASSWORD=            # اگر خالی باشد، رمز تصادفی ساخته و در کنسول چاپ می‌شود
SC_DETECTOR=auto              # auto | yolo | demo
SC_MODEL_PATH=ppe.pt          # داخل پوشه models/
SC_DEVICE=cpu                 # cpu | 0 (GPU)
SC_COOKIE_SECURE=false        # پشت HTTPS برابر true
